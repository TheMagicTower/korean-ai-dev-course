grid-rows: 2
grid-columns: 3
horizontal-gap: 150
vertical-gap: 110
ui: "UI + Mock API\n화면과 가짜 데이터"
test: "UI 테스트 3단계\nPlaywright · 페르소나 · 직접 클릭" {style.stroke: "#ff00ff"}
spec: "스펙·테스트 먼저\nSDD · TDD"
x1: "" {style.opacity: 0; style.stroke-width: 0}
swap: "Mock을 본체로 교체\n화면은 그대로"
body: "본체 구현\n테스트가 기준"
ui -> test -> spec
spec -> body
body -> swap

**.style.font-size: 34
(** -> **)[*].style.font-size: 26
