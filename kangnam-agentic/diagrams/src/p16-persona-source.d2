direction: right
real: "실제 고객 자료" {
  grid-columns: 1
  a: "문의·불만 기록"
  b: "인터뷰 메모"
  c: "사용 로그 요약"
}
clean: "정리" {
  grid-columns: 1
  d: "개인 식별 정보 제거"
