direction: right
bad: "나쁜 조건" {
  b1: "로그인 기능 잘 만들어"
  b2: "테스트 좀 고쳐"
  b3: "리팩터링 끝날 때까지"
}
good: "좋은 조건 = 네 조각" {
  g1: "① 끝 상태 하나: 테스트 통과"
  g2: "② 확인 방법: npm test 종료 코드 0"
  g3: "③ 건드리면 안 되는 것: 테스트 파일 수정 금지"
  g4: "④ 상한: 20턴이면 멈춤"
}
good.style.stroke: "#ff00ff"
bad -> good: "측정 가능하게"

**.style.font-size: 34
(** -> **)[*].style.font-size: 26
