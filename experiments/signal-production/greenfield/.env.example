# 로컬 실행은 명시적으로 local을 선택합니다.
SIGNAL_ENV=local
SIGNAL_DB=/absolute/path/to/signal.sqlite3
SIGNAL_ALLOWED_HOSTS=localhost,127.0.0.1
# production에서는 비밀 저장소에서 무작위 50자 이상 값을 주입하십시오.
# SIGNAL_ENV=production
# SIGNAL_SECRET_KEY=<secure-generated-secret>
# SIGNAL_ALLOWED_HOSTS=magazine.example.org
# 계정 발급 명령 실행 시에만 SIGNAL_OPERATOR_PASSWORD를 주입하고 해제하십시오.
