direction: right
d1: "1일차" {
  b1: "배치 1\n기반 작업 5개"
}
d2: "2일차" {
  b2: "배치 2\n기능 8개"
  r2: "실패 PR 2개\n재배정"
}
d3: "3일차" {
  b3: "배치 3\n연동·화면 6개"
  m3: "머지 큐 통과"
}
d4: "4일차" {
  b4: "마무리\n스모크 · 문서"
  end: "목표 달성\n루프 종료"
}
d1 -> d2 -> d3 -> d4
d4.end.style.stroke: "#ff00ff"

**.style.font-size: 34
(** -> **)[*].style.font-size: 26
