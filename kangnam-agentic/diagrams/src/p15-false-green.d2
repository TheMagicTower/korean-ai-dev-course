direction: right
spec: "스펙"
test: "에이전트가 쓴 테스트" {
  t: "기대값이 틀렸다\n또는 아무것도 검증 안 함"
}
impl: "에이전트가 쓴 구현" {
  i: "테스트에 맞춘 코드"
}
green: "CI 초록불"
real: "실제 화면: 초록불 ≠ 동작" {
  r: "버튼이 안 눌린다\n콘솔에 오류"
}
spec -> test
test -> impl
impl -> green
green -> real {style.stroke-dash: 4}
test.style.stroke: "#ff00ff"
real.style.stroke: "#ff00ff"

**.style.font-size: 34
(** -> **)[*].style.font-size: 26
