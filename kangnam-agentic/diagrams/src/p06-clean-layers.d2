direction: right
fw: "① 프레임워크·드라이버  Frameworks & Drivers" {
  web: "FastAPI"
  pg: "PostgreSQL"
  ad: "② 인터페이스 어댑터  Interface Adapters" {
    ctl: "Reservation\nController"
    repo: "SqlRoom\nRepository"
    uc: "③ 유스케이스  Use Cases" {
      reserve: "ReserveRoom"
      port: "RoomRepository\n(인터페이스)"
      ent: "④ 엔티티  Entities" {
        room: "Room\ncan_reserve()"
      }
    }
  }
}
fw.web -> fw.ad.ctl
fw.ad.ctl -> fw.ad.uc.reserve
fw.ad.repo -> fw.ad.uc.port: "구현"
fw.ad.uc.reserve -> fw.ad.uc.ent.room
fw.ad.repo -> fw.pg: "SQL 실행(호출)" {
  style.stroke: "#9aa4b2"
  style.stroke-dash: 3
  style.font-color: "#c9d1d9"
}
fw.ad.uc.ent.room -> fw.pg: "✗ 금지" {
  style.stroke: "#ff00ff"
  style.stroke-dash: 4
}
fw.ad.uc.ent.style.stroke: "#ff00ff"

**.style.font-size: 40
(** -> **)[*].style.font-size: 34
