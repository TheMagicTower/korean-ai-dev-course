{
  "name": "kangnam-ai-engineering-course",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/assemble-lecture.mjs && node scripts/build-lab-kit.mjs && node scripts/build-jarvis-kit.mjs && node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test:api": "node tests/api.test.mjs",
    "check": "node scripts/check.mjs",
    "test:isolated": "node tests/isolated.mjs",
    "test:lecture": "node --test tests/lecture.test.mjs tests/asset-csp.test.mjs tests/history.test.mjs tests/copy-consistency.test.mjs",
    "test:jarvis": "node --test jarvis-kit/test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.1-beta",
    "wrangler": "4.151.3"
  }
}
