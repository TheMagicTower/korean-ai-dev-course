direction: right
before: "문제: 한 폴더에 에이전트 둘" {
  a: "에이전트 A\n로그인 기능" {width: 240}
  b: "에이전트 B\n검색 기능" {width: 240}
  dir: "app/\n작업 폴더 1개" {width: 270; style.stroke: "#ff00ff"}
  a -> dir: "수정"
  b -> dir: "수정"
}
after: "해법: 워크트리로 폴더 둘" {
  a: "에이전트 A\n로그인 기능" {width: 240}
  b: "에이전트 B\n검색 기능" {width: 240}
  w1: "app-login/\nfeat/login" {width: 270}
  w2: "app-search/\nfeat/search" {width: 270}
  a -> w1
  b -> w2
}
before -> after: "나눈다"

**.style.font-size: 34
(** -> **)[*].style.font-size: 26
