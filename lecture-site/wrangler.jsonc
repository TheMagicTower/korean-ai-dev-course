{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kangnam-ai-engineering",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "account_id": "baeb5f2d19a7ab5f2eb4e9bb39c6b084",
  "preview_urls": false
}
