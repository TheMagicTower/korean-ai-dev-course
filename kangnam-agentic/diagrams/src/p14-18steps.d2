direction: right
g1: "1–4 분석" {
  a: "프로젝트"
  b: "시나리오"
  c: "입출력"
  d: "시장"
}
g2: "5–9 방향 문서화" {
  e: "5 개요"
  f: "6 가이드라인"
  g: "7 ADR 정의"
  h: "8 Spec 개요"
  i: "9 시안"
}
g3: "10–15 분해·등록" {
  j: "10 마일스톤"
  k: "11–13 스테이지·스프린트·Task"
  l: "14 이슈 등록"
  m: "15 워크플로·워크트리"
}
g4: "16–18 구현·운영" {
  n: "16 이슈별 개발·배포"
  o: "17 피드백"
  p: "18 다음 업데이트"
}
g1 -> g2 -> g3 -> g4
g2.g.style.stroke: "#ff00ff"
g4 -> g1: "다음 반복" {style.stroke-dash: 4}

**.style.font-size: 34
(** -> **)[*].style.font-size: 26
