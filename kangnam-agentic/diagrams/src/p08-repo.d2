grid-rows: 4
grid-columns: 2
horizontal-gap: 40
vertical-gap: 40
repo: "todo-app/\n(데모 저장소)"
src: "todo/store.py\n기존 코드"
old: "tests/test_store.py\n기존 테스트"
spec: "docs/spec-overdue.md\n스펙" { style.stroke: "#ff00ff" }
tasks: "TASKS.md\nTask 목록" { style.stroke: "#ff00ff" }
prog: "progress.md\n진행 파일" { style.stroke: "#ff00ff" }
newt: "tests/test_overdue.py\n새 테스트" { style.stroke: "#ff00ff" }
cfg: ".claude/\nsettings·hooks·agents" { style.stroke: "#ff00ff" }

**.style.font-size: 34
(** -> **)[*].style.font-size: 26
